# Environment mode (development / production)
ANEMIA_ENV=development

# Server Configuration
ANEMIA_API_HOST=0.0.0.0
ANEMIA_API_PORT=8000
ANEMIA_CORS_ORIGINS=*
ANEMIA_LOG_LEVEL=INFO

# Optional Custom Path Overrides (Defaults to project root subdirectories)
# ANEMIA_BASE_DIR=/path/to/project
# ANEMIA_CONFIGS_DIR=/path/to/configs
# ANEMIA_MODELS_DIR=/path/to/models
# ANEMIA_DATA_DIR=/path/to/data
