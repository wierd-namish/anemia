# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python & Web
*.py text eol=lf diff=python
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.joblib binary
*.pth binary
*.pt binary
*.onnx binary
